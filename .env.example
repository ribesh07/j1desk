# ── J1soft Tickets mobile app settings ─────────────────────────
# Copy this file to `.env` and fill it in. The file is bundled into the app,
# so only put PUBLIC values here (never a service-account / private key).

# Base URL of the Next.js server (no trailing slash). Swagger: <API_BASE_URL>/api/docs
API_BASE_URL=https://tickets.j1soft.org

# ── Firebase (push notifications) ──────────────────────────────
# Firebase console → Project settings → General → Your apps.
# Add an Android app with package name: org.j1soft.tickets
# The values are in its google-services.json:
#   project_info.project_number  → FIREBASE_MESSAGING_SENDER_ID
#   project_info.project_id      → FIREBASE_PROJECT_ID
#   project_info.storage_bucket  → FIREBASE_STORAGE_BUCKET
#   client[0].client_info.mobilesdk_app_id → FIREBASE_ANDROID_APP_ID
#   client[0].api_key[0].current_key       → FIREBASE_ANDROID_API_KEY
# Leave them empty to run the app without push notifications.
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_ANDROID_APP_ID=
FIREBASE_ANDROID_API_KEY=

# iOS (optional): from GoogleService-Info.plist (GOOGLE_APP_ID / API_KEY). Bundle id: org.j1soft.tickets
FIREBASE_IOS_APP_ID=
FIREBASE_IOS_API_KEY=
